# ==========================================================================
# CS2 AUKSION TIZIMI — Backend muhit sozlamalari
# Ushbu faylni .env nomi bilan nusxalab, haqiqiy qiymatlarni kiriting.
# HECH QACHON to'ldirilgan .env faylini git'ga qo'shmang (.gitignore'da bor).
# ==========================================================================

# --- Server ---
PORT=4000
NODE_ENV=development
# Frontend (Telegram Mini App) qaysi domenda joylashganini bildiradi (CORS uchun)
# DIQQAT: bu manzil pastdagi MINI_APP_URL bilan AYNAN BIR XIL bo'lishi shart!
# (ngrok bilan test qilganda ikkalasini ham har safar yangilashni unutmang —
# aks holda CORS xatosi tufayli Mini App "Kirishda xatolik" beradi. Development
# rejimida istalgan *.ngrok-free.app manzili ham avtomatik qabul qilinadi,
# shuning uchun bu ikkovi farq qilib qolsa ham odatda muammo bo'lmaydi — lekin
# ikkalasini bir xil qilib qo'yish har doim eng ishonchli yo'l.)
FRONTEND_URL=http://localhost:5173
# Backend'ning o'zi tashqi dunyoga qaysi domen orqali ko'rinadi (Click.uz webhooklari shu manzilga keladi)
PUBLIC_BACKEND_URL=https://api.sizningdomeningiz.uz

# --- Ma'lumotlar bazasi ---
# schema.prisma'dagi "provider" bilan mos bo'lishi kerak. Hozir loyiha MySQL/MariaDB
# uchun sozlangan (provider = "mysql"). PostgreSQL ishlatmoqchi bo'lsangiz, ikkalasini
# ham o'zgartiring: provider = "postgresql" va quyidagi URL formatini shunga moslang.
# MySQL/MariaDB: mysql://FOYDALANUVCHI:PAROL@HOST:3306/BAZA_NOMI
# PostgreSQL:    postgresql://FOYDALANUVCHI:PAROL@HOST:5432/BAZA_NOMI?schema=public
DATABASE_URL="mysql://cs2_user:cs2_password@localhost:3306/cs2_auction"

# --- JWT (Telegram initData orqali kirgan foydalanuvchi uchun sessiya tokeni) ---
JWT_SECRET=juda_maxfiy_va_uzun_random_satr_bunga_oxshamasin
JWT_EXPIRES_IN=7d

# --- Telegram: FOYDALANUVCHI boti (masalan @cs2auksion_bot) ---
USER_BOT_TOKEN=0000000000:AAAA-FOYDALANUVCHI-BOT-TOKENI
# Agar server api.telegram.org'ga to'g'ridan-to'g'ri ulana olmasa (ETIMEDOUT xatosi
# chiqsa), shu yerga SOCKS5/HTTP proksi manzilini yozing. Bo'sh qoldirsangiz,
# oddiy to'g'ridan-to'g'ri ulanish ishlatiladi.
#   masalan: socks5://user:parol@host:1080  yoki  http://host:8080
TELEGRAM_PROXY_URL=
# Mini App (React) qaysi https manzilda joylashgan (Telegram faqat https qabul qiladi)
MINI_APP_URL=https://app.sizningdomeningiz.uz

# --- Telegram: ADMIN boti (masalan @cs2admin_auksion_bot) — ALOHIDA bot, alohida token! ---
ADMIN_BOT_TOKEN=1111111111:BBBB-ADMIN-BOT-TOKENI
# Admin uchun alohida Mini App (2-band: yangi auksion yaratish formasi shu yerda)
ADMIN_MINI_APP_URL=https://admin.sizningdomeningiz.uz
# Tizimga birinchi bo'lib SUPERADMIN sifatida kira oladigan Telegram ID(lar), vergul bilan
SUPERADMIN_TELEGRAM_IDS=123456789

# --- Click.uz to'lov tizimi (https://docs.click.uz) ---
# Merchant kabinetida (my.click.uz) xizmatni ro'yxatdan o'tkazgach beriladi
CLICK_SERVICE_ID=00000
CLICK_MERCHANT_ID=00000
CLICK_MERCHANT_USER_ID=00000
CLICK_SECRET_KEY=click_maxfiy_kaliti_bu_yerga
# Checkout (redirect) havolasi bazasi — odatda o'zgarmaydi
CLICK_CHECKOUT_BASE_URL=https://my.click.uz/services/pay
# Merchant API bazaviy manzili — odatda o'zgarmaydi
CLICK_MERCHANT_API_URL=https://api.click.uz/v2/merchant

# --- Auksion biznes-qoidalari (talabga ko'ra sozlanadigan konstantalar) ---
AUCTION_DEPOSIT_PERCENT=25          # har bir taklif uchun ushlanadigan zaklad foizi
AUCTION_MAX_CONSECUTIVE_RAISES=10   # bitta foydalanuvchi ketma-ket necha marta narx oshira oladi
AUCTION_EXTEND_THRESHOLD_MINUTES=5  # tugashiga necha daqiqa qolganda vaqt uzayadi
AUCTION_EXTEND_BY_MINUTES=5         # necha daqiqaga uzayadi
WINNER_PAYMENT_WINDOW_HOURS=5       # g'olib qolgan 75%ni to'lashi uchun berilgan muddat (soat)
DEPOSIT_REFUND_ON_EXPIRY_PERCENT=50 # muddat o'tsa, zakladning necha foizi qaytariladi (qolgani jarima)
